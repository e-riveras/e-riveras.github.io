---
import type { Entry } from '../data/cv';

interface Props {
  title: string;
  entries: Entry[];
}

const { title, entries } = Astro.props;
---

<section>
  <h2>{title}</h2>
  {
    entries.map((e) => (
      <div class="entry">
        <div class="head">
          <h3>
            {e.title}
            <span class="org">
              {e.org}
              {e.place && `, ${e.place}`}
            </span>
          </h3>
          <span class="dates">{e.dates}</span>
        </div>
        {e.points && (
          <ul>
            {e.points.map((p) => (
              <li>{p}</li>
            ))}
          </ul>
        )}
      </div>
    ))
  }
</section>

<style>
  section {
    margin-top: 2.25rem;
  }
  h2 {
    font-size: 0.8125rem;
    font-family: var(--mono);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    padding-bottom: 0.375rem;
    border-bottom: 1px solid var(--line);
    margin-bottom: 1rem;
  }
  .entry + .entry {
    margin-top: 1rem;
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }
  h3 {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0;
  }
  .org {
    display: block;
    font-weight: 400;
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .dates {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--faint);
    white-space: nowrap;
  }
  ul {
    margin: 0.375rem 0 0;
    padding-left: 1.125rem;
    font-size: 0.9375rem;
  }
  li + li {
    margin-top: 0.2rem;
  }
  @media (max-width: 560px) {
    .head {
      flex-direction: column;
      gap: 0.125rem;
    }
  }
  @media print {
    section {
      margin-top: 1.1rem;
      break-inside: auto;
    }
    h2 {
      margin-bottom: 0.5rem;
      break-after: avoid;
    }
    .org {
      display: inline;
    }
    .org::before {
      content: ' · ';
    }
    .entry {
      break-inside: avoid;
    }
    .entry + .entry {
      margin-top: 0.55rem;
    }
    ul {
      margin-top: 0.15rem;
      font-size: 0.875rem;
    }
    li + li {
      margin-top: 0;
    }
  }
</style>
