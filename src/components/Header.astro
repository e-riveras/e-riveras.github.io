---
import { profile } from '../data/cv';

const links = [
  { href: '/projects/', label: 'Projects' },
  { href: '/posts/', label: 'Writing' },
  { href: '/cv/', label: 'CV' },
];
const path = Astro.url.pathname;
---

<header>
  <div class="wrap bar">
    <a class="name" href="/">{profile.shortName}</a>
    <nav aria-label="Main">
      {
        links.map((l) => (
          <a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
      <button id="theme" type="button" aria-label="Toggle dark mode">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path
            fill="currentColor"
            d="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.39 5.39 0 0 1-4.4 2.26 5.4 5.4 0 0 1-3.14-9.8c-.44-.06-.9-.1-1.36-.1Z"
          ></path>
        </svg>
      </button>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('theme');
  btn?.addEventListener('click', () => {
    const root = document.documentElement;
    const current =
      root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });
</script>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 5;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 3.5rem;
  }
  .name {
    font-weight: 650;
    text-decoration: none;
    white-space: nowrap;
  }
  nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    font-size: 0.9375rem;
  }
  nav a {
    color: var(--muted);
    text-decoration: none;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--ink);
  }
  button {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }
  button:hover {
    color: var(--ink);
  }
  @media (max-width: 420px) {
    nav {
      gap: 0.875rem;
    }
  }
</style>
