---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, formatDate } from '../../lib';
import { profile } from '../../data/cv';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.description}>
  <article class="wrap section">
    <a class="back" href="/posts/">← Writing</a>
    <header>
      <h1>{post.data.title}</h1>
      <p class="meta">
        {profile.name} · <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      </p>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .back {
    font-size: 0.875rem;
    color: var(--muted);
    text-decoration: none;
  }
  header {
    max-width: var(--prose);
    margin: 1.5rem 0 2.5rem;
  }
  h1 {
    font-size: clamp(1.875rem, 4vw, 2.5rem);
  }
  .meta {
    color: var(--faint);
    font-size: 0.9375rem;
    margin: 0.75rem 0 0;
  }
</style>
