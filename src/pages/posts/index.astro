---
import Base from '../../layouts/Base.astro';
import { getPosts, formatDate } from '../../lib';

const posts = await getPosts();
---

<Base title="Writing" description="Notes on data science, economics and careers.">
  <div class="wrap section">
    <h1>Writing</h1>
    <ul>
      {
        posts.map((p) => (
          <li>
            <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>
            <div>
              <a href={`/posts/${p.id}/`}>{p.data.title}</a>
              <p>{p.data.description}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  h1 {
    font-size: 2.25rem;
    margin-bottom: 2rem;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: 48rem;
  }
  li {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 1rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--line);
  }
  time {
    font-family: var(--mono);
    font-size: 0.8125rem;
    color: var(--faint);
    padding-top: 0.2rem;
  }
  a {
    font-size: 1.125rem;
    font-weight: 600;
    text-decoration: none;
  }
  p {
    margin: 0.25rem 0 0;
    color: var(--muted);
  }
  @media (max-width: 560px) {
    li {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>
