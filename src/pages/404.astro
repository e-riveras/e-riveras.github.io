---
import Base from '../layouts/Base.astro';
---

<Base title="Not found">
  <div class="wrap section">
    <p class="eyebrow">404</p>
    <h1>Page not found</h1>
    <p>The page may have moved in the site redesign. Try the <a href="/">home page</a>, <a href="/projects/">projects</a> or <a href="/cv/">CV</a>.</p>
  </div>
</Base>

<style>
  h1 {
    font-size: 2.25rem;
    margin: 0.5rem 0 1rem;
  }
  p {
    color: var(--muted);
  }
</style>
